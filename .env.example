# ── Mode ─────────────────────────────────────────────
# true = ใช้ mock data (เปิด dashboard ได้เลยไม่ต้อง credential)
# false = ดึง FB API จริง + เขียน Google Sheets จริง
MOCK_MODE=true

# ── Facebook Marketing API ──────────────────────────
FB_ACCESS_TOKEN=
FB_APP_ID=
FB_APP_SECRET=

# Ad Account ID (Everly only)
FB_ACCOUNT_EVERLY=1965556974211662

# ── Google Sheets / Drive ───────────────────────────
# Path ไป OAuth credentials JSON ที่โหลดจาก Google Cloud
GOOGLE_CREDENTIALS_PATH=./credentials/google_oauth.json
GOOGLE_TOKEN_PATH=./credentials/google_token.json

SHEET_EVERLY=1ont-guA5fzQVwnx4avEqyfvbSrj20aTi

# ── Notification (LINE Messaging API) ───────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID_EVERLY=

# ── Cron / protected sends ─────────────────────────
# Set the same strong random value in Render env vars and GitHub Actions secrets.
CRON_SECRET=

# ── Optional: email fallback (Gmail SMTP) ───────────
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=
